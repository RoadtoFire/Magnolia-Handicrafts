# Copy this file to `.env` (in the same `backend/` directory) and fill in
# real values. `.env` is gitignored and must never be committed.

# Django's cryptographic signing key. Required, no default - the app will
# refuse to start without it. Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NEVER reuse the key that used to be hardcoded in settings.py - that key was
# committed to git history and must be treated as permanently compromised.
DJANGO_SECRET_KEY=change-me-generate-a-real-random-key

# "True"/"False". Must be False in any real deployment.
DJANGO_DEBUG=False

# Comma-separated list of hostnames this Django instance is allowed to serve,
# e.g. "api.example.com,www.example.com". Required (non-empty) when DEBUG=False.
# Production example (placeholder domain - use your real one):
#   DJANGO_ALLOWED_HOSTS=api.magnoliabyrahatjamal.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Standard dj-database-url connection string. If unset, falls back to a local
# sqlite3 file at backend/db.sqlite3 (fine for local dev only). In production
# this is normally provisioned automatically by the host (Render/Railway/
# Heroku Postgres add-ons all inject this exact env var) - you usually just
# need to attach a Postgres database to the app, not hand-build this string.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of origins (scheme+host+port, no trailing slash) that
# are allowed to make cross-origin (cookie-bearing) requests to this API -
# this should be your deployed frontend's URL(s) plus local dev servers.
# Production example:
#   CORS_ALLOWED_ORIGINS=https://www.magnoliabyrahatjamal.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of origins Django trusts for unsafe (POST/PUT/PATCH/
# DELETE) requests carrying CSRF-protected cookies, e.g. your deployed
# frontend origin(s) served over https.
# IMPORTANT: Django requires each entry to include an explicit scheme
# ("https://", not just the bare host) - a scheme-less value is silently
# never matched (see django.middleware.csrf's use of urlsplit() on each
# entry). Production example:
#   CSRF_TRUSTED_ORIGINS=https://www.magnoliabyrahatjamal.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Public URL of the frontend app (used for building links, future email
# templates, etc). Production example:
#   FRONTEND_URL=https://www.magnoliabyrahatjamal.com
FRONTEND_URL=http://localhost:3000

# Optional. Sets the `Domain` attribute on the auth cookies (access_token /
# refresh_token). Leave blank in local dev. In production, set to your apex
# domain WITH a leading dot (e.g. ".magnoliabyrahatjamal.com") if the API and
# frontend share a registrable parent domain across subdomains (e.g. frontend
# on "www.magnoliabyrahatjamal.com", backend on
# "api.magnoliabyrahatjamal.com"); otherwise leave unset.
#
# GETTING THIS WRONG IS A SILENT FAILURE, not an error: admin login will
# appear to succeed (the login response comes back 200 and the cookie gets
# set) but every subsequent admin API call will 401, because the browser
# never attaches the cookie to the cross-subdomain request. This is the exact
# same class of bug as the "localhost vs 127.0.0.1" issue documented in
# web/.env.local.example and web/lib/api.js - both come down to the browser's
# same-site/same-domain cookie rules, just triggered at different layers.
# Production example:
#   AUTH_COOKIE_DOMAIN=.magnoliabyrahatjamal.com
AUTH_COOKIE_DOMAIN=

# Cloudinary connection string for product image storage, e.g.
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave unset/blank in local dev - media then falls back to the local
# filesystem (backend/media/) instead of Cloudinary.
CLOUDINARY_URL=

# --- Phase 2 (payments) ---
# All optional/blank by default - GET /api/payments/methods/ reports which
# gateways are actually usable (i.e. have credentials configured) so the
# frontend can hide the rest until these are filled in.

# Safepay (hosted checkout, card payments) - https://docs.getsafepay.com
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
# "sandbox" or "production"
SAFEPAY_ENV=sandbox

# Easypaisa (hosted checkout / mobile wallet) - Telenor merchant docs
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# "sandbox" or "production"
EASYPAISA_ENV=sandbox

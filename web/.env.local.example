# Base URL of the Django REST API backend.
# Used both server-side (fetches in server components/route metadata) and
# client-side (checkout POST, admin dashboard, etc) — must be prefixed
# NEXT_PUBLIC_ to be available in the browser bundle.
#
# IMPORTANT: keep this on the "localhost" host, not "127.0.0.1", to match
# whatever host this Next.js app itself runs on (NEXT_PUBLIC_SITE_URL
# below). The admin section's login cookies are set SameSite=Lax by the
# backend, and browsers treat "localhost" and "127.0.0.1" as different
# sites — a mismatch here makes admin login look like it worked (the
# cookie gets set) while every subsequent admin API call silently 401s
# (the cookie never gets attached to the cross-site request).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL this Next.js site itself is served from — used for
# metadataBase, sitemap.xml, and robots.txt absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
